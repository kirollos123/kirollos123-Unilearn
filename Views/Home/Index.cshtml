@{ViewData["Title"] = "Home";}
<div class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <span class="hero-badge mb-3 d-inline-block">BESTSELLER</span>
        <h1>Learn from the Best Instructors</h1>
        <p class="mt-3">Access courses, meet instructors, and track your learning journey.</p>
        <div class="d-flex gap-3 mt-4">
          <a href="/Course" class="btn btn-accent btn-lg px-4">Explore Courses</a>
          <a href="/Instructor" class="btn btn-outline-light btn-lg px-4">Meet Instructors</a>
        </div>
      </div>
      <div class="col-lg-5 text-center d-none d-lg-block">
        <i class="fas fa-graduation-cap" style="font-size:10rem;opacity:0.15;color:white"></i>
      </div>
    </div>
  </div>
</div>
<div class="container my-5">
  <div class="row g-4 text-center">
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mx-auto" style="background:var(--accent)"><i class="fas fa-chalkboard-teacher"></i></div>
        <h3 style="color:var(--accent)">Expert</h3><p>Instructors</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mx-auto" style="background:#0ea5e9"><i class="fas fa-book-open"></i></div>
        <h3 style="color:#0ea5e9">Quality</h3><p>Courses</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mx-auto" style="background:#10b981"><i class="fas fa-building"></i></div>
        <h3 style="color:#10b981">Multiple</h3><p>Departments</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mx-auto" style="background:var(--gold)"><i class="fas fa-user-graduate"></i></div>
        <h3 style="color:var(--gold)">Talented</h3><p>Trainees</p>
      </div>
    </div>
  </div>
</div>