@model UniversityApp_1.Models.Department
@{ViewData["Title"] = Model.Name;}
<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb breadcrumb-udemy">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/Department">Departments</a></li>
      <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
  </nav>
  <div class="detail-header mt-3">
    <div class="d-flex align-items-center gap-4">
      <div class="detail-avatar-placeholder"><i class="fas fa-building"></i></div>
      <div>
        <h2 class="fw-800 mb-1">@Model.Name</h2>
        <div class="info-row"><i class="fas fa-user"></i><span>Manager: @Model.Manager</span></div>
      </div>
    </div>
  </div>
  <div class="row g-4 mt-1">
    <div class="col-md-4">
      <div class="form-card">
        <h6 class="fw-bold mb-3"><i class="fas fa-chalkboard-teacher me-2" style="color:var(--accent)"></i>Instructors (@Model.Instructors.Count)</h6>
        @foreach (var i in Model.Instructors) {
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar-circle">@i.Name[0]</div>
            <a href="/Instructor/Detail/@i.Id">@i.Name</a>
          </div>
        }
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-card">
        <h6 class="fw-bold mb-3"><i class="fas fa-book me-2" style="color:#0ea5e9"></i>Courses (@Model.Courses.Count)</h6>
        @foreach (var c in Model.Courses) {
          <div class="mb-2"><span class="badge-course">@c.Name</span></div>
        }
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-card">
        <h6 class="fw-bold mb-3"><i class="fas fa-user-graduate me-2" style="color:var(--gold)"></i>Trainees (@Model.Trainees.Count)</h6>
        @foreach (var t in Model.Trainees) {
          <div class="mb-2">@t.Name</div>
        }
      </div>
    </div>
  </div>
  <a href="/Department" class="btn btn-primary-udemy mt-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>