@model IEnumerable<UniversityApp_1.Models.Department>
@{ViewData["Title"] = "Departments";}

<div class="page-header">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mt-2">
      <h2><i class="fas fa-building me-2" style="color:var(--accent)"></i>Departments</h2>
      @if (User.IsInRole("Admin")) {
        <a asp-action="Create" class="btn btn-primary-udemy"><i class="fas fa-plus me-1"></i>Add Department</a>
      }
    </div>
  </div>
</div>

<div class="container pb-5">
  <div class="table-udemy">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>#</th>
          <th>Department Name</th>
          <th>Manager</th>
          <th>Instructors</th>
          <th>Trainees</th>
          <th>Courses</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var dept in Model)
        {
          <tr>
            <td class="text-muted">@dept.Id</td>
            <td><div class="fw-semibold">@dept.Name</div></td>
            <td>@dept.Manager</td>
            <td><span class="badge-dept">@dept.Instructors.Count</span></td>
            <td><span class="badge-course">@dept.Trainees.Count</span></td>
            <td>@dept.Courses.Count</td>
            <td>
              <a asp-action="Details" asp-route-id="@dept.Id" class="btn-view me-1"><i class="fas fa-eye"></i></a>
              @if (User.IsInRole("Admin")) {
                <a asp-action="Edit" asp-route-id="@dept.Id" class="btn-edit me-1"><i class="fas fa-edit"></i></a>
                <a asp-action="Delete" asp-route-id="@dept.Id" class="btn-del"><i class="fas fa-trash"></i></a>
              }
            </td>
          </tr>
        }
        @if (!Model.Any()) {
          <tr><td colspan="7" class="text-center py-5 text-muted">No departments found.</td></tr>
        }
      </tbody>
    </table>
  </div>
</div>
