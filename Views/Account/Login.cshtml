@{ViewData["Title"] = "Login";}
<div class="container py-5"><div class="row justify-content-center"><div class="col-md-5">
  <div class="form-card">
    <div class="text-center mb-4">
      <h2 class="fw-800">Welcome back!</h2>
      <p class="text-muted">Log in to your UniLearn account</p>
    </div>
    @if (!ViewData.ModelState.IsValid) {
      <div class="alert alert-danger py-2">@Html.ValidationSummary()</div>
    }
    <form method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3"><label class="form-label">Email</label><input type="email" name="email" class="form-control" placeholder="you@example.com" required /></div>
      <div class="mb-3"><label class="form-label">Password</label><input type="password" name="password" class="form-control" placeholder="password" required /></div>
      <button type="submit" class="btn btn-primary-udemy w-100 py-2 mt-2">Log In</button>
    </form>
    <hr />
    <p class="text-center text-muted mb-0">No account? <a href="/Account/Register" style="color:var(--accent)">Sign Up</a></p>
    <div class="alert alert-light mt-3 text-center" style="font-size:0.8rem">
      <strong>Admin:</strong> admin@university.com / Admin@123
    </div>
  </div>
</div></div></div>