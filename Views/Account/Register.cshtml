@{ViewData["Title"] = "Register";}
<div class="container py-5"><div class="row justify-content-center"><div class="col-md-5">
  <div class="form-card">
    <div class="text-center mb-4">
      <h2 class="fw-800">Create Account</h2>
      <p class="text-muted">Join UniLearn today</p>
    </div>
    @if (!ViewData.ModelState.IsValid) {
      <div class="alert alert-danger py-2">@Html.ValidationSummary()</div>
    }
    <form method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3"><label class="form-label">Full Name</label><input type="text" name="fullName" class="form-control" required /></div>
      <div class="mb-3"><label class="form-label">Email</label><input type="email" name="email" class="form-control" required /></div>
      <div class="mb-3"><label class="form-label">Password</label><input type="password" name="password" class="form-control" required /></div>
      <button type="submit" class="btn btn-primary-udemy w-100 py-2 mt-2">Create Account</button>
    </form>
    <hr />
    <p class="text-center text-muted mb-0">Have an account? <a href="/Account/Login" style="color:var(--accent)">Log In</a></p>
  </div>
</div></div></div>