@model UniversityApp_1.Models.Instructor
@{ViewData["Title"] = Model.Name;}

<div class="container py-5" style="max-width:600px">
  <div class="detail-header">
    <div class="d-flex align-items-center gap-4">
      @if (!string.IsNullOrEmpty(Model.Image))
      {
        <img src="@Model.Image" class="detail-avatar" />
      }
      else
      {
        <div class="detail-avatar-placeholder">@Model.Name[0]</div>
      }
      <div>
        <h3 class="mb-1">@Model.Name</h3>
        <div class="info-row"><i class="fas fa-building"></i> @(Model.Department?.Name ?? "—")</div>
        <div class="info-row"><i class="fas fa-book"></i> @(Model.Course?.Name ?? "No course assigned")</div>
        @if (User.IsInRole("Admin"))
        {
          <div class="info-row"><i class="fas fa-map-marker-alt"></i> @(Model.Address ?? "—")</div>
          <div class="info-row"><i class="fas fa-dollar-sign"></i> $@Model.Salary.ToString("N0")</div>
        }
      </div>
    </div>
  </div>

  <div class="mt-3 d-flex gap-2">
    <a href="/Instructor" class="btn btn-outline-secondary">← Back</a>
    @if (User.IsInRole("Admin"))
    {
      <a href="/Instructor/Edit/@Model.Id" class="btn btn-warning">Edit</a>
      <a href="/Instructor/Delete/@Model.Id" class="btn btn-danger">Delete</a>
    }
  </div>
</div>
