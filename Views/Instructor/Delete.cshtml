@model UniversityApp_1.Models.Instructor
@{ViewData["Title"] = "Delete";}
<div class="container py-5"><div class="row justify-content-center"><div class="col-md-5">
  <div class="form-card text-center">
    <div style="width:70px;height:70px;background:#fee2e2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-size:1.8rem;color:#dc2626">
      <i class="fas fa-trash"></i>
    </div>
    <h4>Delete <strong>@Model.Name</strong>?</h4>
    <p class="text-muted">This action cannot be undone.</p>
    <form method="post">
      @Html.AntiForgeryToken()
      <div class="d-flex gap-2 justify-content-center mt-3">
        <button type="submit" class="btn btn-danger px-4">Delete</button>
        <a href="/Instructor" class="btn btn-light px-4">Cancel</a>
      </div>
    </form>
  </div>
</div></div></div>