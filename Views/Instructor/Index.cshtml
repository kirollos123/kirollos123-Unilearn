@model IEnumerable<UniversityApp_1.Models.Instructor>
@{ViewData["Title"] = "Instructors";}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-udemy">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Instructors</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <h2><i class="fas fa-chalkboard-teacher me-2" style="color:var(--accent)"></i>Instructors</h2>
            @if (User.IsInRole("Admin"))
            {
                <a href="/Instructor/Create" class="btn btn-primary-udemy">
                    <i class="fas fa-plus me-1"></i>Add Instructor
                </a>
            }
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row mb-4">
        <div class="col-md-5">
            <form method="get" action="/Instructor">
                <div class="search-bar">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" name="searchName" value="@ViewBag.SearchName" placeholder="Search instructor by name..." />
                    <button type="submit" class="btn-search">Search</button>
                </div>
            </form>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.SearchName as string))
        {
            <div class="col-md-4 d-flex align-items-center">
                <span class="text-muted me-2">Results for: <strong>@ViewBag.SearchName</strong></span>
                <a href="/Instructor" class="btn btn-sm btn-light">Clear</a>
            </div>
        }
    </div>

    <div class="table-udemy">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Instructor</th>
                    @if (User.IsInRole("Admin")) { <th>Salary</th> }
                    <th>Department</th>
                    <th>Course</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td class="text-muted">@i.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(i.Image))
                                {
                                    <img src="@i.Image" class="avatar-img" />
                                }
                                else
                                {
                                    <div class="avatar-circle">@i.Name[0]</div>
                                }
                                <div>
                                    <div class="fw-semibold">@i.Name</div>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <small class="text-muted">@i.Address</small>
                                    }
                                </div>
                            </div>
                        </td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td><strong>$@i.Salary.ToString("N0")</strong></td>
                        }
                        <td><span class="badge-dept">@(i.Department?.Name ?? "none")</span></td>
                        <td><span class="badge-course">@(i.Course?.Name ?? "none")</span></td>
                        <td>
                            <a href="/Instructor/Detail/@i.Id" class="btn-view me-1"><i class="fas fa-eye"></i></a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Instructor/Edit/@i.Id" class="btn-edit me-1"><i class="fas fa-edit"></i></a>
                                <a href="/Instructor/Delete/@i.Id" class="btn-del"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-2x mb-2 d-block"></i>
                            No instructors found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
