@model UniversityApp_1.Models.Instructor
@{ViewData["Title"] = "Edit Instructor";}
<div class="page-header"><div class="container"><h2>Edit Instructor</h2></div></div>
<div class="container pb-5"><div class="row"><div class="col-md-6"><div class="form-card">
  <form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="Image" type="hidden" />
    <div class="mb-3"><label class="form-label">Full Name</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Salary</label><input asp-for="Salary" class="form-control" type="number" step="0.01" /></div>
    <div class="mb-3"><label class="form-label">Department</label>
      @Html.DropDownList("DeptId", ViewBag.Departments as SelectList, new { @class = "form-select" })
    </div>
    <div class="mb-3"><label class="form-label">Course</label>
      @Html.DropDownList("CrsId", ViewBag.Courses as SelectList, "-- None --", new { @class = "form-select" })
    </div>
    <div class="mb-3"><label class="form-label">New Photo</label><input type="file" name="imageFile" class="form-control" accept="image/*" />
      @if (!string.IsNullOrEmpty(Model.Image)) {
        <img src="@Model.Image" style="height:60px;border-radius:50%;margin-top:8px" />
      }
    </div>
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary-udemy px-4">Update</button>
      <a href="/Instructor" class="btn btn-light px-4">Cancel</a>
    </div>
  </form>
</div></div></div></div>