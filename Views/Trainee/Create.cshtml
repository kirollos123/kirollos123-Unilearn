@model UniversityApp_1.Models.Trainee
@{ViewData["Title"] = "Add Trainee";}
<div class="page-header"><div class="container"><h2>Add Trainee</h2></div></div>
<div class="container pb-5"><div class="row"><div class="col-md-6"><div class="form-card">
  <form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="mb-3"><label class="form-label">Full Name</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Grade</label><input asp-for="Grade" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Department</label>
      @Html.DropDownList("DeptId", ViewBag.Departments as SelectList, "-- Select --", new { @class = "form-select" })
    </div>
    <div class="mb-3"><label class="form-label">Photo</label><input type="file" name="imageFile" class="form-control" accept="image/*" /></div>
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary-udemy px-4">Save</button>
      <a href="/Trainee" class="btn btn-light px-4">Cancel</a>
    </div>
  </form>
</div></div></div></div>