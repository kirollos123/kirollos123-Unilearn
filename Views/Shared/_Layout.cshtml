<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniLearn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <style>
        :root {
            --primary: #1c1d1f;
            --accent: #a435f0;
            --accent-hover: #8710d8;
            --gold: #f69c08;
            --light-bg: #f7f9fa;
            --border: #d1d7dc;
            --text-muted: #6a6f73;
        }
        * { font-family: 'Inter', sans-serif; }
        body { background: var(--light-bg); }

        /* NAVBAR */
        .navbar { background: var(--primary) !important; padding: 0 1rem; height: 60px; }
        .navbar-brand { color: #fff !important; font-size: 1.5rem; font-weight: 800; letter-spacing: -1px; }
        .navbar-brand span { color: var(--accent); }
        .nav-link { color: #ccc !important; font-size: 0.875rem; font-weight: 500; padding: 0.5rem 0.75rem !important; }
        .nav-link:hover { color: #fff !important; }
        .btn-accent { background: var(--accent); color: #fff; border: none; padding: 0.4rem 1rem; border-radius: 4px; font-size: 0.85rem; font-weight: 600; }
        .btn-accent:hover { background: var(--accent-hover); color: #fff; }
        .btn-outline-light-sm { border: 1px solid #fff; color: #fff; padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: 4px; }
        .btn-outline-light-sm:hover { background: #fff; color: var(--primary); }

        /* HERO */
        .hero-section { background: linear-gradient(135deg, #1c1d1f 0%, #2d2f31 60%, #3e0a6b 100%); color: white; padding: 4rem 0; }
        .hero-section h1 { font-size: 2.5rem; font-weight: 800; line-height: 1.2; }
        .hero-section p { font-size: 1.1rem; color: #d1d7dc; }
        .hero-badge { background: var(--gold); color: #000; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 3px; }

        /* CARDS */
        .card-udemy { border: 1px solid var(--border); border-radius: 6px; overflow: hidden; transition: box-shadow 0.2s, transform 0.2s; background: #fff; }
        .card-udemy:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.15); transform: translateY(-3px); }
        .card-udemy .card-img-top { height: 160px; object-fit: cover; }
        .card-udemy .card-img-placeholder { height: 160px; background: linear-gradient(135deg, var(--accent) 0%, #6610f2 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 2.5rem; }
        .card-udemy .card-body { padding: 1rem; }
        .card-udemy .card-title { font-size: 0.9rem; font-weight: 700; color: var(--primary); margin-bottom: 0.3rem; line-height: 1.3; }
        .card-udemy .instructor-name { font-size: 0.75rem; color: var(--text-muted); }
        .card-udemy .price { font-size: 1rem; font-weight: 700; color: var(--primary); }
        .rating-stars { color: var(--gold); font-size: 0.75rem; }

        /* STAT CARDS */
        .stat-card { background: #fff; border-radius: 8px; padding: 1.5rem; border: 1px solid var(--border); text-align: center; }
        .stat-card .stat-icon { width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem; font-size: 1.4rem; color: #fff; }
        .stat-card h3 { font-size: 1.8rem; font-weight: 800; margin: 0; }
        .stat-card p { color: var(--text-muted); font-size: 0.85rem; margin: 0; }

        /* TABLE */
        .table-udemy { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
        .table-udemy thead { background: var(--primary); color: white; }
        .table-udemy thead th { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; padding: 1rem; border: none; }
        .table-udemy tbody td { padding: 0.85rem 1rem; vertical-align: middle; font-size: 0.875rem; border-color: #f0f0f0; }
        .table-udemy tbody tr:hover { background: #f7f9fa; }
        .avatar-circle { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), #6610f2); display: inline-flex; align-items: center; justify-content: center; color: white; font-size: 0.85rem; font-weight: 700; }
        .avatar-img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; }

        /* SEARCH BAR */
        .search-bar { position: relative; }
        .search-bar input { border: 2px solid var(--border); border-radius: 4px; padding: 0.6rem 1rem 0.6rem 2.8rem; font-size: 0.9rem; width: 100%; }
        .search-bar input:focus { border-color: var(--accent); outline: none; box-shadow: none; }
        .search-bar .search-icon { position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
        .search-bar .btn-search { position: absolute; right: 4px; top: 4px; bottom: 4px; background: var(--accent); color: white; border: none; padding: 0 1rem; border-radius: 3px; font-size: 0.85rem; }

        /* BADGES */
        .badge-dept { background: #e8f4fd; color: #0369a1; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
        .badge-course { background: #fef3c7; color: #92400e; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }

        /* BREADCRUMB */
        .breadcrumb-udemy { background: none; padding: 0; margin: 0; font-size: 0.8rem; }
        .breadcrumb-udemy .breadcrumb-item a { color: var(--accent); text-decoration: none; }
        .breadcrumb-udemy .breadcrumb-item.active { color: var(--text-muted); }

        /* BUTTONS */
        .btn-primary-udemy { background: var(--accent); color: white; border: none; border-radius: 4px; font-weight: 600; font-size: 0.875rem; padding: 0.5rem 1.25rem; }
        .btn-primary-udemy:hover { background: var(--accent-hover); color: white; }
        .btn-edit { background: #f0f0f0; color: #333; border: none; border-radius: 4px; font-size: 0.8rem; padding: 0.3rem 0.7rem; }
        .btn-edit:hover { background: #e0e0e0; }
        .btn-del { background: #fee2e2; color: #dc2626; border: none; border-radius: 4px; font-size: 0.8rem; padding: 0.3rem 0.7rem; }
        .btn-del:hover { background: #fecaca; }
        .btn-view { background: #ede9fe; color: #7c3aed; border: none; border-radius: 4px; font-size: 0.8rem; padding: 0.3rem 0.7rem; }
        .btn-view:hover { background: #ddd6fe; }

        /* PAGE HEADER */
        .page-header { background: #fff; border-bottom: 1px solid var(--border); padding: 1.5rem 0; margin-bottom: 2rem; }
        .page-header h2 { font-size: 1.5rem; font-weight: 800; color: var(--primary); margin: 0; }

        /* FORM */
        .form-card { background: #fff; border-radius: 8px; border: 1px solid var(--border); padding: 2rem; }
        .form-label { font-size: 0.85rem; font-weight: 600; color: var(--primary); }
        .form-control, .form-select { border: 1px solid var(--border); border-radius: 4px; font-size: 0.875rem; }
        .form-control:focus, .form-select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(164,53,240,0.1); }

        /* DETAIL PAGE */
        .detail-header { background: linear-gradient(135deg, #1c1d1f, #3e0a6b); color: white; padding: 2.5rem; border-radius: 8px; margin-bottom: 1.5rem; }
        .detail-avatar { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,0.3); }
        .detail-avatar-placeholder { width: 90px; height: 90px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 2rem; color: white; border: 3px solid rgba(255,255,255,0.3); }
        .info-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.875rem; }
        .info-row i { width: 18px; color: rgba(255,255,255,0.7); }

        footer { background: var(--primary); color: #ccc; padding: 2rem 0; margin-top: 4rem; font-size: 0.85rem; }
        footer a { color: #aaa; text-decoration: none; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/">Uni<span>Learn</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/Instructor"><i class="fas fa-chalkboard-teacher me-1"></i>Instructors</a></li>
                <li class="nav-item"><a class="nav-link" href="/Course"><i class="fas fa-book me-1"></i>Courses</a></li>
                <li class="nav-item"><a class="nav-link" href="/Department"><i class="fas fa-building me-1"></i>Departments</a></li>
                <li class="nav-item"><a class="nav-link" href="/Enrollment/MyCourses"><i class="fas fa-graduation-cap me-1"></i>My Courses</a></li>
                @if (User.IsInRole("Admin")) {
                <li class="nav-item"><a class="nav-link" href="/Trainee"><i class="fas fa-user-graduate me-1"></i>Trainees</a></li>
                }
            </ul>
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                @if (User.Identity!.IsAuthenticated)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" href="/Admin"><i class="fas fa-tachometer-alt me-1"></i>Dashboard</a></li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="/Enrollment/Profile"><i class="fas fa-user-circle me-1"></i>@User.Identity.Name</a>
                    </li>
                    <li class="nav-item">
                        <form method="post" action="/Account/Logout" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light-sm">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="btn btn-outline-light-sm" href="/Account/Login">Log In</a></li>
                    <li class="nav-item"><a class="btn-accent btn" href="/Account/Register">Sign Up</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main>@RenderBody()</main>

<footer>
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <h5 class="text-white fw-bold">Uni<span style="color:var(--accent)">Learn</span></h5>
                <p>University Management System — Built with ASP.NET Core MVC</p>
            </div>
            <div class="col-md-4">
                <h6 class="text-white">Quick Links</h6>
                <div><a href="/Instructor">Instructors</a> · <a href="/Course">Courses</a> · <a href="/Department">Departments</a></div>
            </div>
            <div class="col-md-4 text-md-end">
                <p>Information Technology Department<br/>4th Year — 2025/2026</p>
            </div>
        </div>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
