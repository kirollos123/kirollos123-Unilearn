@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Manage Roles";
}

<div class="container mt-4" style="max-width:600px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🔑 Manage Roles</h2>
        <a asp-action="Index" class="btn btn-secondary">← Dashboard</a>
    </div>

    <form asp-action="CreateRole" method="post" class="d-flex gap-2 mb-4">
        <input type="text" name="roleName" class="form-control" placeholder="New role name..." required />
        <button type="submit" class="btn btn-success">Add Role</button>
    </form>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr><th>Role Name</th><th>Delete</th></tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td><span class="badge bg-dark fs-6">@role.Name</span></td>
                    <td>
                        <form asp-action="DeleteRole" method="post"
                              onsubmit="return confirm('Delete role @role.Name?')">
                            <input type="hidden" name="id" value="@role.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
