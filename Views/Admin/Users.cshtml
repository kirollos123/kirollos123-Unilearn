@model IEnumerable<UniversityApp_1.Controllers.UserViewModel>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>👥 Manage Users</h2>
        <a asp-action="Index" class="btn btn-secondary">← Dashboard</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Change Role</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge bg-primary">@role</span>
                        }
                    </td>
                    <td>
                        <form asp-action="ChangeRole" method="post" class="d-flex gap-1">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <select name="newRole" class="form-select form-select-sm">
                                <option value="Admin">Admin</option>
                                <option value="User">User</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-warning">Change</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="DeleteUser" method="post"
                              onsubmit="return confirm('Delete @user.FullName?')">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
