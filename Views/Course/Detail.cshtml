@model UniversityApp_1.Models.Course
@{ViewData["Title"] = Model.Name;}

@{
    var userId = Context.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container py-5" style="max-width:800px">
  <div class="detail-header">
    <div class="d-flex align-items-center gap-4">
      <div class="detail-avatar-placeholder" style="font-size:2.5rem">
        <i class="fas fa-book-open"></i>
      </div>
      <div>
        <h3 class="mb-1">@Model.Name</h3>
        <div class="info-row"><i class="fas fa-building"></i> @(Model.Department?.Name ?? "—")</div>
        <div class="info-row"><i class="fas fa-clock"></i> @Model.Hours hours</div>
        <div class="info-row"><i class="fas fa-trophy"></i> Max: @Model.Degree pts &nbsp;|&nbsp; Min: @Model.MinDegree pts</div>
      </div>
    </div>
  </div>

  @if (TempData["Success"] != null)
  {<div class="alert alert-success">@TempData["Success"]</div>}
  @if (TempData["Info"] != null)
  {<div class="alert alert-info">@TempData["Info"]</div>}

  @if (User.Identity!.IsAuthenticated && !User.IsInRole("Admin"))
  {
    <div class="mb-4">
      <form asp-controller="Enrollment" asp-action="Enroll" method="post" class="d-inline">
        <input type="hidden" name="courseId" value="@Model.Id" />
        <button type="submit" class="btn btn-primary-udemy">
          <i class="fas fa-plus me-1"></i>Enroll in this Course
        </button>
      </form>
      <a href="/Enrollment/MyCourses" class="btn btn-outline-secondary ms-2">My Courses</a>
    </div>
  }

  <h5 class="mb-3">Instructors (@Model.Instructors.Count)</h5>
  <div class="table-udemy mb-4">
    <table class="table table-hover mb-0">
      <thead><tr><th>Instructor</th><th>Salary</th></tr></thead>
      <tbody>
        @foreach (var i in Model.Instructors)
        {
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <div class="avatar-circle">@i.Name[0]</div>
                <span class="fw-semibold">@i.Name</span>
              </div>
            </td>
            <td>$@i.Salary.ToString("N0")</td>
          </tr>
        }
        @if (!Model.Instructors.Any())
        {<tr><td colspan="2" class="text-muted text-center">No instructors assigned.</td></tr>}
      </tbody>
    </table>
  </div>

  <h5 class="mb-3">Enrolled Students (@Model.CrsResults.Count)</h5>
  <div class="table-udemy">
    <table class="table table-hover mb-0">
      <thead><tr><th>Student</th><th>Grade</th></tr></thead>
      <tbody>
        @foreach (var r in Model.CrsResults)
        {
          <tr>
            <td>@(r.Trainee?.Name ?? "—")</td>
            <td><span class="badge-course">@r.Degree pts</span></td>
          </tr>
        }
        @if (!Model.CrsResults.Any())
        {<tr><td colspan="2" class="text-muted text-center">No results yet.</td></tr>}
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <a href="/Course" class="btn btn-outline-secondary">← Back to Courses</a>
  </div>
</div>
